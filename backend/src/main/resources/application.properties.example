spring.application.name=honghu-backend
server.port=8080

# Database
spring.datasource.url=${HONGHU_DB_URL:jdbc:mysql://localhost:3306/honghu?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true}
spring.datasource.username=${HONGHU_DB_USER:root}
spring.datasource.password=${HONGHU_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl

# PageHelper
pagehelper.helper-dialect=mysql
pagehelper.reasonable=true
pagehelper.support-methods-arguments=true

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.encoding=UTF-8

# Set HONGHU_JWT_SECRET to a random value of at least 32 bytes.
jwt.secret=${HONGHU_JWT_SECRET}
jwt.expiration=43200

# File Storage
storage.type=local
storage.local.base-path=./uploads

# SpringDoc OpenAPI
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
